PORT=3000

# Configuración de PostgreSQL
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_de_tu_base

# Para envío de correos electrónicos
CORREO=tu_correo@gmail.com
CLAVE=tu_clave  # No es la de Gmail

# Clave JWT (para generarla, en Node poner el comando: require("crypto").randomBytes(32).toString("hex");)
JWT_SECRET=clave_secreta